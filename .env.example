# Application
APP_NAME=Infinite Gist
# Generate with: openssl rand -hex 48
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database
DATABASE_URL=sqlite:///./infinite_gist.db

# Required only for docker-compose.prod.yml
POSTGRES_USER=infinite_gist
POSTGRES_PASSWORD=change-this-to-a-random-database-password
POSTGRES_DB=infinite_gist

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Security
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
ENCRYPTION_KEY=

# Runtime workers and proxy trust
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
ENABLE_TRUFFLEHOG=true
TRUST_PROXY_HEADERS=false
COOKIE_SECURE=false

# Optional SMTP delivery (notifications return failure until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
